{
  "name": "my-v1-addon",
  "version": "1.7.0",
  "private": true,
  "description": "A v1 addon with ember-intl",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ember-intl/ember-intl.git"
  },
  "author": "Isaac J. Lee",
  "typesVersions": {
    "*": {
      "test-support": [
        "declarations/addon-test-support/index.d.ts"
      ],
      "test-support/*": [
        "declarations/addon-test-support/*",
        "declarations/addon-test-support/*/index.d.ts"
      ],
      "*": [
        "declarations/addon/*",
        "declarations/addon/*/index.d.ts"
      ]
    }
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "_prepack": "tsc --project tsconfig.build.json",
    "build": "ember build --environment production",
    "build:test": "ember build --environment test",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:intl": "ember-intl-lint",
    "lint:intl:fix": "ember-intl-lint --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "ember serve",
    "test": "pnpm build:test && ember-test --port 0",
    "test:watch": "concurrently \"pnpm build:test --watch\" && \"pnpm ember-test --server\" --names build,test"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "ember-auto-import": "^2.13.1",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-template-imports": "^4.4.0"
  },
  "devDependencies": {
    "@ember-intl/lint": "workspace:*",
    "@ember-intl/v1-compat": "workspace:*",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.5.1",
    "@embroider/test-setup": "^4.0.0",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/ember-tsc": "^1.11.6",
    "@glint/template": "^1.9.0",
    "@shared-configs/eslint-config-ember": "workspace:*",
    "@shared-configs/eslint-config-yaml": "workspace:*",
    "@shared-configs/prettier": "workspace:*",
    "@shared-configs/testem": "workspace:*",
    "@shared-configs/typescript": "workspace:*",
    "@types/qunit": "^2.19.14",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^10.0.5",
    "ember-cli": "~6.12.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-intl": "workspace:*",
    "ember-load-initializers": "^3.0.1",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.0",
    "ember-testem": "^0.3.0",
    "eslint": "^10.11.0",
    "loader.js": "^4.7.0",
    "prettier": "^3.9.9",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1"
  },
  "peerDependencies": {
    "ember-intl": "workspace:*"
  },
  "peerDependenciesMeta": {
    "ember-intl": {
      "optional": false
    }
  },
  "engines": {
    "node": "22.* || >= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config"
  }
}
